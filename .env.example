# SafeVision Edge — Environment Configuration Example

# Server binding
SAFEVISION_HOST=0.0.0.0
SAFEVISION_PORT=8000

# Model Paths
SAFEVISION_CPU_MODEL=models/custom_model.pte
SAFEVISION_NPU_MODEL=models/npu/custom_model.hef

# Hailo Environment
HAILO_VENV_PATH=~/hailo-venv

# Logging
SAFEVISION_LOG_LEVEL=info
